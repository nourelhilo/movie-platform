# Backend API URL
# Local: Vite proxies /api to http://localhost:5000 (run the server too)
# Production (Vercel): leave as /api/v1 so the frontend and API share the same origin
VITE_API_URL=/api/v1

# Firebase Client Configuration (from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
