# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/movie_platform?retryWrites=true&w=majority
# Example Local MongoDB: mongodb://127.0.0.1:27017/movie_platform
MONGODB_URI=mongodb://127.0.0.1:27017/movie_platform

# TMDB External API (v3 API Key or v4 Read Access Token)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Firebase Admin SDK Configuration
# Option 1: Path to your downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# Option 2: Or paste the project ID for verification fallback
FIREBASE_PROJECT_ID=
